FROM node:22-bookworm

WORKDIR /app

# Enable corepack
RUN corepack enable

# Install Rust
RUN apt-get update && apt-get install -y curl build-essential
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy source
COPY . .

# Install dependencies
RUN yarn install

# Build native module
RUN rm -f packages/backend/native/server-native.node
RUN yarn workspace @affine/server-native build
RUN ls -l packages/backend/native/server-native.node

# Build reader
RUN yarn workspace @affine/reader build

# Build frontend so it can be copied to static
RUN git init && git add . && git config user.email "build@affine.pro" && git config user.name "Build" && git commit -m "build" || true
RUN yarn affine bundle -p @affine/web
RUN mkdir -p /app/packages/backend/server/static
RUN cp -r /app/packages/frontend/apps/web/dist/* /app/packages/backend/server/static/

# Build admin panel
RUN yarn affine bundle -p @affine/admin
RUN mkdir -p /app/packages/backend/server/static/admin
RUN cp -r /app/packages/frontend/admin/dist/* /app/packages/backend/server/static/admin/

# Create mobile assets manifest (required by backend)
RUN mkdir -p /app/packages/backend/server/static/mobile
RUN echo '{"js":[],"css":[]}' > /app/packages/backend/server/static/mobile/assets-manifest.json

# Fix native module by providing dummy files for alternative architectures so rspack bundle doesn't fail
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.x64.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.arm64.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.armv7.node || true

# Build backend
RUN yarn workspace @affine/server build

ENV PORT=3010
ENV NODE_ENV=production

EXPOSE 3010

CMD ["node", "packages/backend/server/dist/main.js"]

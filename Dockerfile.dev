FROM node:22-bookworm

WORKDIR /app

# Enable corepack to use the correct yarn version
RUN corepack enable

# Install Rust toolchain
RUN apt-get update && apt-get install -y curl build-essential
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Copy source code
COPY . .

# Install dependencies
RUN yarn install

# Build native module explicitly to ensure Linux binary is generated
RUN rm -f packages/backend/native/server-native.node
RUN yarn workspace @affine/server-native build
RUN ls -l packages/backend/native/server-native.node

# Build reader dependency
RUN yarn workspace @affine/reader build

# Build frontend from source
# Increase Node memory for frontend build
ENV NODE_OPTIONS="--max-old-space-size=8192"
RUN yarn workspace @affine/web build

# Copy built frontend to static directory
RUN cp -r /app/packages/frontend/apps/web/dist/* /app/packages/backend/server/static/

# Create admin static files
RUN mkdir -p /app/packages/backend/server/static/admin
RUN echo '\u003c!DOCTYPE html\u003e\u003chtml\u003e\u003chead\u003e\u003ctitle\u003eAFFiNE Admin\u003c/title\u003e\u003c/head\u003e\u003cbody\u003e\u003ch1\u003eAFFiNE Admin\u003c/h1\u003e\u003c/body\u003e\u003c/html\u003e' > /app/packages/backend/server/static/admin/selfhost.html

# Fix native module name mismatch
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.x64.node || true

# Build the server
RUN yarn workspace @affine/server build

# Set environment variables
ENV PORT=3010
ENV NODE_ENV=production

# Expose port
EXPOSE 3010

# Run the server
CMD ["node", "packages/backend/server/dist/main.js"]

# Production Environment Variables
# Copy to .env.prod and customize with secure values

# Environment
ENV=prod
NODE_ENV=production

# Database (CHANGE THESE!)
DB_USERNAME=affine
DB_PASSWORD=CHANGE_ME_SECURE_PASSWORD_123
DB_DATABASE=affine
DB_VERSION=16

# Server
AFFINE_PORT=3010
AFFINE_SERVER_EXTERNAL_URL=https://your-domain.com

# AI/Copilot
AFFINE_COPILOT_ENABLED=true
GEMINI_ENABLED=true
GEMINI_BRIDGE_URL=http://gemini-bridge:8765

# Storage Locations (Production paths)
CONFIG_LOCATION=/var/lib/affine/config
UPLOAD_LOCATION=/var/lib/affine/storage
DB_DATA_LOCATION=/var/lib/postgresql/data

# Logging
LOG_LEVEL=info

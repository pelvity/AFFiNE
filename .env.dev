# ============================================
# AFFiNE Development Environment Configuration
# ============================================
# Copy this file to .env.dev.local and customize for your local setup
# DO NOT commit .env.dev.local to git!

# ============================================
# Node Environment
# ============================================
NODE_ENV=development
AFFINE_ENV=dev

# ============================================
# Server Configuration
# ============================================
PORT=3010
HOST=0.0.0.0
AFFINE_SERVER_EXTERNAL_URL=http://13.48.24.34:3010
AFFINE_SERVER_HOST=13.48.24.34
AFFINE_SERVER_HTTPS=false

# ============================================
# Database Configuration (Development)
# ============================================
DB_USERNAME=affine_dev
DB_PASSWORD=dev_password_change_me
DB_DATABASE=affine_dev
DATABASE_URL=postgresql://affine_dev:dev_password_change_me@postgres:5432/affine_dev

# Postgres Version
DB_VERSION=16

# ============================================
# Redis Configuration
# ============================================
REDIS_SERVER_HOST=redis
REDIS_SERVER_PORT=6379

# ============================================
# Feature Flags (Development - Enable All for Testing)
# ============================================
AFFINE_COPILOT_ENABLED=true
AFFINE_INDEXER_ENABLED=false
AFFINE_AUTH_ENABLED=false

# ============================================
# AI/Copilot Providers (Development)
# ============================================
# Gemini WebAPI
AFFINE_COPILOT_PROVIDERS_GEMINIWEBAPI_BASE_URL=http://host.docker.internal:8765
AFFINE_COPILOT_PROVIDERS_GEMINIWEBAPI_ENABLED=true

# OpenAI (Optional - add your key for testing)
# AFFINE_COPILOT_PROVIDERS_OPENAI_API_KEY=
# AFFINE_COPILOT_PROVIDERS_OPENAI_ENABLED=false

# ============================================
# Storage Configuration
# ============================================
# Windows paths for development
UPLOAD_LOCATION=C:\\Users\\admin\\.affine\\dev\\storage
CONFIG_LOCATION=C:\\Users\\admin\\.affine\\dev\\config
DB_DATA_LOCATION=C:\\Users\\admin\\.affine\\dev\\postgres\\pgdata

# ============================================
# Logging & Debugging
# ============================================
DEBUG=affine:*
LOG_LEVEL=debug
FORCE_COLOR=true
DEBUG_COLORS=true

# ============================================
# Email (Development - Use Mailpit)
# ============================================
MAILER_HOST=mailpit
MAILER_PORT=1025
MAILER_USER=
MAILER_PASSWORD=
MAILER_SENDER=noreply@affine.dev

# ============================================
# Authentication (Development)
# ============================================
# Disable for easier development
AFFINE_AUTH_ENABLED=false
# If enabled, set these:
# JWT_SECRET=dev-secret-change-me
# SESSION_SECRET=dev-session-secret-change-me

# ============================================
# Gemini Bridge Configuration
# ============================================
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
COOKIE_REFRESH_INTERVAL=3600

# ============================================
# Development Tools
# ============================================
# Enable GraphQL Playground
GRAPHQL_PLAYGROUND=true

# Hot Module Replacement
HMR_ENABLED=true

# ============================================
# Performance (Development - Lower Limits)
# ============================================
# Max file upload size (in bytes)
MAX_FILE_SIZE=104857600

# Request timeout (ms)
REQUEST_TIMEOUT=30000

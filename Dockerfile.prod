# ==========================================
# 1. Builder Stage
# ==========================================
FROM node:22-bookworm AS builder

WORKDIR /app

# Enable corepack
RUN corepack enable

# Install Build Dependencies (Rust, C++, etc.)
RUN apt-get update && apt-get install -y curl build-essential git python3
# Install Rust from official image
COPY --from=rust:1.92-bookworm /usr/local/cargo /usr/local/cargo
COPY --from=rust:1.92-bookworm /usr/local/rustup /usr/local/rustup
ENV PATH="/usr/local/cargo/bin:${PATH}"
ENV RUSTUP_HOME="/usr/local/rustup"
ENV CARGO_HOME="/usr/local/cargo"

# Copy source code
COPY . .

# Install dependencies
# Reduced from 8192 to 4096 for 4GB RAM server
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN yarn install

# Build Native Backend
RUN rm -f packages/backend/native/server-native.node
RUN yarn workspace @affine/server-native build
# Fix native module naming for production and satisfy Webpack bundle requirements
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.linux-x64-gnu.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.x64.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.arm64.node || true
RUN cp packages/backend/native/server-native.node packages/backend/native/server-native.armv7.node || true

# Build reader dependency
RUN yarn workspace @affine/reader build

# Build Frontend
# Initialize git for build versioning
RUN git init && git add . && git config user.email "build@affine.pro" && git config user.name "Build" && git commit -m "build"
RUN yarn affine bundle -p @affine/web

# Build Backend Server
# Use direct bundle command as workspace script fails silently
RUN yarn affine bundle -p @affine/server

# Prune dev dependencies to reduce size (for the runner stage copy)
# Note: In a complex monorepo, sometimes pruning removes too much, 
# so we'll do a careful copy or install prod deps in the runner.
# For now, we will copy 'node_modules' from this stage but we could optimize further.

# ==========================================
# 2. Runner Stage
# ==========================================
FROM node:22-bookworm-slim AS runner

WORKDIR /app

# Install runtime requirements (libs required by native modules)
RUN apt-get update && apt-get install -y openssl ca-certificates && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=3010

# Copy necessary files from builder
# 1. Copy node_modules (This includes prod deps - strict pruning in monorepo is hard without 'turbo prune')
#    We will copy the installed modules. A better approach is 'yarn workspaces focus --production' but stick to safe copy for now.
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/yarn.lock /app/yarn.lock
COPY --from=builder /app/.yarnrc.yml /app/.yarnrc.yml
COPY --from=builder /app/.yarn /app/.yarn

# Enable corepack in runner for yarn support
RUN corepack enable

# 2. Copy workspace packages configs
COPY --from=builder /app/packages /app/packages

# 3. Cleanup sources in runner to save SOME space (remove src, leaving dist)
#    (This command runs inside the runner image layer)
#    We mainly need:
#    - packages/backend/server/dist
#    - packages/backend/native
#    - packages/frontend/apps/web/dist (static files)

# 4. Prepare static files directory
RUN mkdir -p /app/packages/backend/server/static && \
    cp -r /app/packages/frontend/apps/web/dist/* /app/packages/backend/server/static/ && \
    mkdir -p /app/packages/backend/server/static/mobile && \
    echo "{}" > /app/packages/backend/server/static/mobile/assets-manifest.json

# Expose port
EXPOSE 3010

# Run the server
CMD ["node", "packages/backend/server/dist/main.js"]

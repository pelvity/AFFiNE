# ============================================
# AFFiNE Production Environment Configuration
# ============================================
# Copy this file to .env.prod.local and customize for your production setup
# NEVER commit .env.prod.local to git!
# USE SECRETS MANAGEMENT for sensitive values in production!

# ============================================
# Node Environment
# ============================================
NODE_ENV=production
AFFINE_ENV=production

# ============================================
# Server Configuration
# ============================================
PORT=3010
HOST=0.0.0.0
# IMPORTANT: Set your actual domain
AFFINE_SERVER_EXTERNAL_URL=https://your-domain.com
AFFINE_SERVER_HOST=your-domain.com
AFFINE_SERVER_HTTPS=true

# ============================================
# Database Configuration (Production)
# ============================================
# SECURITY: Use strong passwords and secrets management!
DB_USERNAME=affine
DB_PASSWORD=  # SET VIA SECRETS MANAGEMENT
DB_DATABASE=affine
DATABASE_URL=  # SET VIA SECRETS MANAGEMENT
# Example: postgresql://affine:STRONG_PASSWORD@postgres:5432/affine

# Postgres Version
DB_VERSION=16

# ============================================
# Redis Configuration
# ============================================
REDIS_SERVER_HOST=redis
REDIS_SERVER_PORT=6379
# REDIS_PASSWORD=  # SET IF USING REDIS AUTH

# ============================================
# Feature Flags (Production - Selective)
# ============================================
AFFINE_COPILOT_ENABLED=true
AFFINE_INDEXER_ENABLED=false  # Resource intensive, enable if needed
AFFINE_AUTH_ENABLED=true  # Always enable in production

# ============================================
# AI/Copilot Providers (Production)
# ============================================
# Gemini WebAPI
AFFINE_COPILOT_PROVIDERS_GEMINIWEBAPI_BASE_URL=http://gemini-bridge:8765
AFFINE_COPILOT_PROVIDERS_GEMINIWEBAPI_ENABLED=true

# OpenAI (Optional)
# AFFINE_COPILOT_PROVIDERS_OPENAI_API_KEY=  # SET VIA SECRETS
# AFFINE_COPILOT_PROVIDERS_OPENAI_ENABLED=false

# ============================================
# Storage Configuration
# ============================================
# Production paths - use absolute paths or volumes
UPLOAD_LOCATION=/root/.affine/storage
CONFIG_LOCATION=/root/.affine/config
DB_DATA_LOCATION=/var/lib/postgresql/data

# ============================================
# Logging (Production)
# ============================================
LOG_LEVEL=info  # Use 'warn' or 'error' for less verbose logging
# DEBUG=  # Disable debug in production

# ============================================
# Email (Production - Use Real SMTP)
# ============================================
MAILER_HOST=smtp.your-provider.com
MAILER_PORT=587
MAILER_USER=  # SET VIA SECRETS
MAILER_PASSWORD=  # SET VIA SECRETS
MAILER_SENDER=noreply@your-domain.com
MAILER_SECURE=true

# ============================================
# Authentication (Production)
# ============================================
AFFINE_AUTH_ENABLED=true
# SECURITY: Use strong, random secrets!
JWT_SECRET=  # SET VIA SECRETS - Use: openssl rand -base64 32
SESSION_SECRET=  # SET VIA SECRETS - Use: openssl rand -base64 32

# OAuth Providers (if needed)
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# ============================================
# Security
# ============================================
# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# SSL/TLS (if terminating SSL at application)
# ============================================
# SSL_KEY_PATH=/etc/ssl/private/key.pem
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem

# ============================================
# Monitoring & Observability
# ============================================
# Enable metrics endpoint
METRICS_ENABLED=true

# Sentry (Error Tracking)
# SENTRY_DSN=

# ============================================
# Performance (Production)
# ============================================
# Max file upload size (in bytes) - 100MB
MAX_FILE_SIZE=104857600

# Request timeout (ms)
REQUEST_TIMEOUT=30000

# Worker threads
WORKER_THREADS=4

# ============================================
# Backup & Maintenance
# ============================================
# Automatic backup configuration
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# ============================================
# CDN & Static Assets
# ============================================
# CDN_URL=https://cdn.your-domain.com

# ============================================
# Third-party Services
# ============================================
# Stripe (if using payments)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=

# Analytics
# MIXPANEL_TOKEN=
# GOOGLE_ANALYTICS_ID=

# ============================================
# Docker Image Version
# ============================================
AFFINE_REVISION=stable  # Options: stable, beta, canary

# Production Environment Variables for Local Acer Server
# Copy to .env.prod.local on the server

# Environment
ENV=prod
NODE_ENV=production

# Database
DB_USERNAME=affine
DB_PASSWORD=SecureProductionPassword123
DB_DATABASE=affine
DB_VERSION=16
DATABASE_URL=postgresql://affine:SecureProductionPassword123@postgres:5432/affine

# Server
AFFINE_PORT=3010
AFFINE_SERVER_EXTERNAL_URL=http://10.0.0.1:3010

# AI/Copilot
AFFINE_COPILOT_ENABLED=true
GEMINI_ENABLED=true
GEMINI_BRIDGE_URL=http://gemini-bridge:8765

# Storage Locations (Linux paths relative to compose file)
CONFIG_LOCATION=./data/config
UPLOAD_LOCATION=./data/storage
DB_DATA_LOCATION=./data/postgres

# Logging
LOG_LEVEL=info

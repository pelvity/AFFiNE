# Development Environment Variables
# Copy to .env and customize as needed

# Environment
ENV=dev
NODE_ENV=development

# Database
DB_USERNAME=affine_dev
DB_PASSWORD=dev_password_change_me
DB_DATABASE=affine_dev
DB_VERSION=16

# Server
AFFINE_PORT=3010
AFFINE_SERVER_EXTERNAL_URL=http://localhost:3010

# AI/Copilot
AFFINE_COPILOT_ENABLED=true
GEMINI_ENABLED=true
# Point to local bridge (not Docker)
GEMINI_BRIDGE_URL=http://host.docker.internal:8765

# Storage Locations (Windows paths)
CONFIG_LOCATION=C:\\Users\\admin\\.affine\\dev\\config
UPLOAD_LOCATION=C:\\Users\\admin\\.affine\\dev\\storage
DB_DATA_LOCATION=C:\\Users\\admin\\.affine\\dev\\postgres\\pgdata
